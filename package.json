{
  "name": "my-app",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "prepare": "pnpm run env:setup && pnpm run git:hooks && node scripts/init.mjs --auto",
    "init": "node scripts/init.mjs",
    "git:hooks": "node scripts/git-hooks.mjs",
    "env:setup": "node scripts/env-setup.mjs",
    "rename": "node scripts/rename.mjs",
    "db:up": "node scripts/db.mjs up",
    "db:down": "node scripts/db.mjs down",
    "db:refresh": "pnpm run db:down -v && pnpm run db:up && pnpm run db:migrate && pnpm run db:seed",
    "stack:up": "node scripts/compose.mjs up -d --build",
    "stack:down": "node scripts/compose.mjs down",
    "image:api": "node scripts/image.mjs api",
    "image:web": "node scripts/image.mjs web",
    "db:migrate": "node scripts/backend.mjs migrate",
    "db:seed": "node scripts/backend.mjs seed",
    "backend:build": "node scripts/backend.mjs build",
    "backend:test": "node scripts/backend.mjs test",
    "backend:lint": "node scripts/backend.mjs lint",
    "backend:format": "node scripts/backend.mjs format",
    "backend:dev": "node scripts/backend.mjs run",
    "dev": "node scripts/dev.mjs",
    "design:preview": "node scripts/design-preview.mjs",
    "public-version": "node scripts/public-version.mjs",
    "public-version:set": "node scripts/public-version.mjs set",
    "public-version:check": "node scripts/public-version.mjs check",
    "build": "pnpm run backend:build && pnpm -r run build",
    "lint": "pnpm run backend:lint && eslint .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm run backend:test && pnpm -r run test && pnpm run test:scripts && pnpm run test:design-process",
    "test:scripts": "node --test \"scripts/*.test.mjs\" \"scripts/lib/*.test.mjs\"",
    "test:design-process": "node --test \"process/design/scripts/*.test.mjs\"",
    "verify": "pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run openapi:check",
    "test:integration": "node scripts/test-integration.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:e2e:ui": "node scripts/test-e2e.mjs --ui",
    "openapi:sync": "node scripts/openapi-sync.mjs && pnpm --filter ./packages/schemas run build",
    "openapi:check": "pnpm run openapi:sync && git diff --exit-code packages/schemas/",
    "pw": "node scripts/pw.mjs",
    "pw:help": "node scripts/pw.mjs --help",
    "pw:list": "node scripts/pw.mjs list",
    "pw:show": "node scripts/pw.mjs show",
    "pw:close-all": "node scripts/pw.mjs close-all",
    "spec": "openspec",
    "spec:init": "openspec init",
    "spec:update": "openspec update",
    "spec:new": "openspec new change",
    "spec:list": "openspec list",
    "spec:view": "openspec view",
    "spec:show": "openspec show",
    "spec:status": "openspec status",
    "spec:instructions": "openspec instructions",
    "spec:validate": "openspec validate",
    "spec:archive": "openspec archive --yes",
    "check:links": "node scripts/check-links.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fission-ai/openspec": "^1.2.0",
    "@playwright/cli": "^0.1.1",
    "@playwright/test": "^1.60.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.1"
  }
}
